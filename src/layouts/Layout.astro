---
import '../styles/tokens.css';
import { withBase } from '../lib/base';

interface Props {
	title?: string;
}

const { title = 'Citizen Development Governance Model' } = Astro.props;

const navLinks = [
	{ href: withBase(''), label: 'Tracker' },
	{ href: withBase('framework/'), label: 'Framework doc' },
];

const currentPath = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="app-header">
			<div class="wrap app-header__row">
				<div>
					<p class="eyebrow">Fictional demo with synthetic data, part of Tavor Ben Shahar's portfolio</p>
					<a href={withBase('')} class="wordmark">Citizen Development Governance Model</a>
				</div>
				<nav aria-label="Main">
					<ul class="nav-list">
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main class="wrap">
			<slot />
		</main>

		<footer class="app-footer">
			<div class="wrap">
				<p>Meridian Dynamics is a fictional company used only for this demo and Project 1.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.wrap {
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: var(--space-3);
	}

	.app-header {
		border-bottom: 1px solid var(--color-border);
	}

	.app-header__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-block: var(--space-3);
	}

	.eyebrow {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		margin: 0 0 var(--space-1);
	}

	.wordmark {
		font-weight: 700;
		font-size: var(--text-lg);
		color: var(--color-text);
		text-decoration: none;
	}

	.nav-list {
		list-style: none;
		display: flex;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
	}

	.nav-list a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.nav-list a:hover,
	.nav-list a[aria-current='page'] {
		color: var(--color-accent);
	}

	main {
		padding-block: var(--space-5);
	}

	.app-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-bg-subtle);
		padding-block: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
</style>
