---
import Layout from '../layouts/Layout.astro';
import StageBoard from '../components/StageBoard.astro';
---

<Layout>
	<p class="intro">
		A stage tracker for Meridian Dynamics' internally built tools, idea through production, each
		with an explicit maintenance owner. Cards with a health line pull a real, live "last commit /
		contributor count" signal from the GitHub API for a repo standing in for that tool.
	</p>

	<StageBoard />
</Layout>

<style>
	.intro {
		max-width: 42rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-5);
	}
</style>

<script>
	import { fetchRepoHealth } from '../lib/github';

	const cards = document.querySelectorAll<HTMLElement>('[data-repo-owner]');

	for (const card of cards) {
		const owner = card.dataset.repoOwner;
		const name = card.dataset.repoName;
		const healthEl = card.querySelector<HTMLElement>('[data-health]');
		if (!owner || !name || !healthEl) continue;

		fetchRepoHealth(owner, name).then((health) => {
			if (health.error || !health.lastCommitDate) {
				healthEl.textContent = `GitHub check failed (${health.error ?? 'no data'})`;
				return;
			}
			const lastCommit = new Date(health.lastCommitDate).toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			});
			const contributors = health.contributorCount ?? '?';
			healthEl.textContent = `Last commit ${lastCommit} · ${contributors} contributor${contributors === 1 ? '' : 's'} (${owner}/${name})`;
		});
	}
</script>
